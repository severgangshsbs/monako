export default async function handler req, res, if req. met hod not POST вернуть статус 405 с ошибкой. Достань name и phone из req.body, собери text со строками «Новая заявка», имя и телефон, отправь это через fetch на api.telegram.org / bot process.env.TELEGRAM_BOT_TOKEN /sendMessage POST с JSON телом, содержащим chat_id process.env TELEGRAM_CHAT_ID и text. Если ответ не ок, вернуть статус 500 с ошибкой. В конце вернуть status 200 с success.
